<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading GSI images -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Large images are stored in app-specific external storage, no broad
         storage permission needed on API 26+ with scoped storage -->

    <!-- Optional: only requested/used if root is detected on the host device,
         purely to enable /dev/kvm access for hardware-accelerated QEMU.
         The app never attempts to obtain root itself. -->
    <uses-feature android:name="android.hardware.ram.normal" android:required="false" />

    <application
        android:name=".VmGsiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VmGsi"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runs the QEMU process and manages its lifecycle independent of the
             foreground UI, with a persistent notification while a VM is running -->
        <service
            android:name=".qemu.QemuVmService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Long-running, resumable GSI downloads -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            tools:node="merge" />

    </application>

</manifest>
